// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Student {
  id          Int          @id @default(autoincrement())
  name        String
  birthday    DateTime?    @db.Date
  telephone   String?
  weekday     Weekday?
  shift       StudioShift? @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  shiftId     Int?
  isActive    Boolean      @default(true)
  studio      Studio       @relation(fields: [studioId], references: [id])
  studioId    Int          @default(1)
  user        User?        @relation(fields: [userId], references: [id])
  userId      String?
  invitations Invitation[]
  months      Month[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([studioId, userId])
  @@index([shiftId])
}

model User {
  id                 String              @id @default(cuid())
  name               String?
  email              String              @unique
  emailVerified      DateTime?
  image              String?
  isPlatformAdmin    Boolean             @default(false)
  activeStudio       Studio?             @relation("ActiveStudio", fields: [activeStudioId], references: [id], onDelete: SetNull)
  activeStudioId     Int?
  accounts           Account[]
  sessions           Session[]
  passwordCredential PasswordCredential?
  memberships        Membership[]
  students           Student[]
  invitationsSent    Invitation[]        @relation("InvitationSender")
  authTokens         AuthToken[]
  auditEvents        AuditLog[]          @relation("AuditActor")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordCredential {
  userId       String   @id
  passwordHash String   @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Studio {
  id          Int           @id @default(autoincrement())
  name        String
  slug        String        @unique
  description String?
  address     String?
  telephone   String?
  isActive    Boolean       @default(true)
  students    Student[]
  memberships Membership[]
  invitations Invitation[]
  activeUsers User[]        @relation("ActiveStudio")
  shifts      StudioShift[]
  auditLogs   AuditLog[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model StudioShift {
  id        Int       @id @default(autoincrement())
  studioId  Int
  startTime String    @db.VarChar(5)
  label     String?
  isActive  Boolean   @default(true)
  sortOrder Int       @default(0)
  studio    Studio    @relation(fields: [studioId], references: [id], onDelete: Cascade)
  students  Student[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([studioId, startTime])
  @@index([studioId, isActive, sortOrder])
}

model AuditLog {
  id         String      @id @default(cuid())
  studioId   Int
  actorId    String?
  action     AuditAction
  entityType String
  entityId   String?
  metadata   Json?
  studio     Studio      @relation(fields: [studioId], references: [id], onDelete: Cascade)
  actor      User?       @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt  DateTime    @default(now())

  @@index([studioId, createdAt])
  @@index([actorId, createdAt])
}

model Membership {
  id        String         @id @default(cuid())
  userId    String
  studioId  Int
  role      MembershipRole
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  studio    Studio         @relation(fields: [studioId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([userId, studioId])
  @@index([studioId, role])
}

model Invitation {
  id          String           @id @default(cuid())
  email       String
  tokenHash   String           @unique
  role        MembershipRole
  status      InvitationStatus @default(PENDING)
  studioId    Int
  studentId   Int?
  invitedById String?
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  studio      Studio           @relation(fields: [studioId], references: [id], onDelete: Cascade)
  student     Student?         @relation(fields: [studentId], references: [id], onDelete: SetNull)
  invitedBy   User?            @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([email, status])
  @@index([studentId])
  @@index([studioId, status])
}

model AuthToken {
  id         String        @id @default(cuid())
  tokenHash  String        @unique
  type       AuthTokenType
  userId     String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime      @default(now())
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
}

model AuthRateLimit {
  key          String    @id
  count        Int
  windowStart  DateTime
  blockedUntil DateTime?
  updatedAt    DateTime  @updatedAt

  @@index([blockedUntil])
}

model Month {
  id        Int      @id @default(autoincrement())
  year      Int
  month     Int
  student   Student  @relation(fields: [studentId], references: [id])
  studentId Int
  classes   Class[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, year, month])
}

model Class {
  id                    Int           @id @default(autoincrement())
  className             String
  assistance            Boolean       @default(false)
  classDay              DateTime?     @db.Date
  classPrice            Decimal       @db.Decimal(12, 2)
  classPaymentStatus    PaymentStatus @default(PENDING)
  ovenName              String?
  ovenPrice             Decimal       @default(0) @db.Decimal(12, 2)
  ovenPaymentStatus     PaymentStatus @default(PENDING)
  materialName          String?
  materialPrice         Decimal       @default(0) @db.Decimal(12, 2)
  materialPaymentStatus PaymentStatus @default(PENDING)
  month                 Month         @relation(fields: [monthId], references: [id])
  monthId               Int
  charges               ClassCharge[]
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
}

model ClassCharge {
  id            Int           @id @default(autoincrement())
  type          ChargeType
  description   String?
  price         Decimal       @db.Decimal(12, 2)
  paymentStatus PaymentStatus @default(PENDING)
  needsReview   Boolean       @default(false)
  legacyDetail  String?
  class         Class         @relation(fields: [classId], references: [id], onDelete: Cascade)
  classId       Int
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([classId, type])
  @@index([needsReview])
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  ASSIGN
  UNASSIGN
  SWITCH
}

enum PaymentStatus {
  PENDING
  PAID
}

enum ChargeType {
  OVEN
  MATERIAL
}

enum MembershipRole {
  OWNER
  ADMIN
  STUDENT
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}
